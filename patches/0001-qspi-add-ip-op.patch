+static bool fsl_qspi_node_is_bgt(const struct device_node *np)
+{
+	return of_device_is_compatible(np, "infineon,bgt60atr24c");
+}
+
+static int fsl_qspi_count_nor_children(struct device_node *np)
+{
+	struct device_node *child;
+	int count = 0;
+
+	for_each_available_child_of_node(np, child) {
+		if (fsl_qspi_node_is_bgt(child))
+			continue;
+		count++;
+	}
+	return count;
+}
+
+static bool fsl_qspi_has_bgt_child(struct device_node *np)
+{
+	struct device_node *child;
+
+	for_each_available_child_of_node(np, child) {
+		if (fsl_qspi_node_is_bgt(child))
+			return true;
+	}
+	return false;
+}
 
